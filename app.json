{
  "expo": {
    "name": "OpenDoor",
    "slug": "open-doo-mobile",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/psaslogo.png",
    "scheme": "opendoomobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pogi123.opendoormobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/psaslogo.png",
        "backgroundImage": "./assets/images/lvccgate.jpg",
        "monochromeImage": "./assets/images/psaslogo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.pogi_123.opendoomobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "09088e89-77d1-4ad4-8095-c3fa1edf35de"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/09088e89-77d1-4ad4-8095-c3fa1edf35de"
    },
    "owner": "vinceaintreadin"
  }
}
